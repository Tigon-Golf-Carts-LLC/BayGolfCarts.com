# Copy to .env (never commit .env) or set these in Vercel → Settings → Environment Variables.

# Server only. This webhook's own signing secret from
# TIGON IOT → Webhook Flows → Webhooks → BAY GOLF CARTS → Setup packet → Developers → "Create secret".
# Used by api/tigon-lead.js. NEVER prefix it with VITE_ (that would ship it to browsers).
TIGON_WEBHOOK_SECRET=

# Optional, build-time. Set to /api/tigon-lead to send leads through the signing function.
# Leave empty to post directly from the browser to the TIGON webhook.
VITE_TIGON_LEAD_ENDPOINT=
